# Auth
AUTH_SECRET=long-random-string-here
NEXT_PUBLIC_APP_URL=http://localhost:3000
# GitHub OAuth (create at github.com/settings/developers) — omit both for demo login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Turso database (get credentials at turso.tech) — projects, users, credits
TURSO_DATABASE_URL=libsql://your-db-name-yourorg.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
# For local dev without Turso, use: TURSO_DATABASE_URL=file:local.db
# Stripe (Pro $15/mo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID=
